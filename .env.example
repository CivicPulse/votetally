# Cloudflare R2 credentials.
# Create an R2 API token at https://dash.cloudflare.com/?to=/:account/r2/api-tokens
# (Account API Token, "Object Read & Write" on the chosen bucket).

R2_ACCOUNT_ID=your-32-char-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=votetally-data

# 2captcha account API key (https://2captcha.com/setting). Used by `votetally fetch`
# to mint a reCAPTCHA v3 Enterprise token for the GA SOS submit gate. ~$0.40/mo at
# the project's scrape cadence.
TWOCAPTCHA_API_KEY=your-2captcha-api-key
