_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
# Ignore folders generated by Bundler
.bundle/
vendor/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Local secrets and config
.env
.env.local
*.pem

# Local working data (downloaded zips and extracted CSVs are not source)
data/local/
*.zip
*.csv

# Recon artifacts (large; kept locally for reference, not for commit)
.recon/
.firecrawl/

# Generated locally for preview only — production reads from R2 via _redirects.
# Regenerate with: uv run votetally dump-shape > site/turnout.json
site/turnout.json

# Firefox profile copy used by experiments/ (contains user cookies/history;
# never commit, never transmit)
experiments/firefox-profile-copy/
experiments/artifacts/

# Wrangler local cache (created by npx wrangler pages deploy)
.wrangler/

# Screenshots are local dev artifacts (per CLAUDE.md global preference)
screenshots/*.png
screenshots/*.jpg

# Playwright MCP working directory (snapshots, console logs)
.playwright-mcp/

# Cron wrapper log — appended to on every scheduled run
scripts/cron-hub.log

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# CLI agent / session tooling (Claude Code, Codex, Gemini, Qwen, plugin state).
# These directories are per-machine session caches and tool config — not
# project code, never the same across two contributors, never useful in CI.
.agents/
.claude/
.pi/
.qwen/
skills-lock.json
